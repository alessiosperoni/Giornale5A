@page "/messaggio"

<PageTitle>Messaggi</PageTitle>

<h1>Elenco dei messaggi</h1>

<p>Carica di dati da un web api RESTful</p>

@if (listaMessaggi == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>Messaggio: @singoloMessaggio.Mittente id: @singoloMessaggio.IdMessaggio</p>
    <table class="table">
        <thead>
            <tr>
                <th>Id messaggio</th>
                <th>Mittente</th>
                <th>Destinatario</th>
                <th>Testo del messaggio</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in listaMessaggi)
            {
                <tr>
                    <td>@m.IdMessaggio</td>
                    <td>@m.Mittente</td>
                    <td>@m.Destinatario</td>
                    <td>@m.Testo</td>
                </tr>
            }
        </tbody>
    </table>

    <p>Messaggio: @singoloCommento.autoreCommento id: @singoloCommento.idCommento</p>
    <table class="table">
        <thead>
            <tr>
                <th>Id Commento</th>
                <th>Autore</th>
                <th>Testo</th>
                <th>Data</th>
                <th>Id Articolo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in listaCommento)
            {
                <tr>
                    <td>@m.idArticolo</td>
                    <td>@m.autoreCommento</td>
                    <td>@m.testoCommento</td>
                    <td>@m.dataCommento</td>
                    <td>@m.idArticolo</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    private Messaggio[]? listaMessaggi;
    Messaggio? singoloMessaggio;
    private Commento[]? listaCommento;
    Commento? singoloCommento;
    protected override async Task OnInitializedAsync()
    {   
        
        HttpClient? cl = new HttpClient();
        cl.BaseAddress = new Uri("http://localhost:5140"); //blazor
        //cl.BaseAddress = new Uri("http://localhost:8081"); //java
        //cl.BaseAddress = new Uri("http://localhost:3000"); //nodejs
        singoloMessaggio = await cl.GetFromJsonAsync<Messaggio>("Messaggio/messaggi/2");
        listaMessaggi = await cl.GetFromJsonAsync<Messaggio[]>("Messaggio/MessaggiosList");
        singoloCommento = await cl.GetFromJsonAsync<Commento>("Comment/commento/1");
        listaCommento = await cl.GetFromJsonAsync<Commento[]>("Comment/CommentiList");

    }
}
